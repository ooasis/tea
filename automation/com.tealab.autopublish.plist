<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.tealab.autopublish</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd /Users/155715/tools/tea-lab && echo "=== run $(date) ===" >> ~/Library/Logs/tea-autopublish.log && /Users/155715/.nvm/versions/node/v22.23.1/bin/claude -p "/auto-publish" --dangerously-skip-permissions >> ~/Library/Logs/tea-autopublish.log 2>&1</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <!-- ponytail: nvm path is node-version-pinned; update here after nvm upgrades.
         Homebrew's claude is broken under node 26, so we pin the working nvm install. -->
    <string>/Users/155715/.nvm/versions/node/v22.23.1/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>10</integer>
    <key>Minute</key>
    <integer>15</integer>
  </dict>
</dict>
</plist>
